		annotation SummarizationSetBy = Automatic

	partition *Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				CALENDAR (DATE (2023, 1, 1), DATE (2026, 12, 31)),
				"Year", YEAR([Date]),
				"Month Number", MONTH([Date]),
				"Day of the Month", DAY([Date]),
				"Weekday", WEEKDAY([Date]),
				"Week Number", WEEKNUM([Date]),
				//"Month of the Year", MONTH([Date])&" "&YEAR([Date]),
				"Quarter1", QUARTER([Date]),
				"Quarter", CONCATENATE("Q", FORMAT([Date], "Q")),
				"Day of the Week", FORMAT([Date], "dddd"),
				 "Month", FORMAT([Date], "MMMM"),
				"Reporting Week Date", [Date] - WEEKDAY([Date], 2) + 1,
				"Month and Year", FORMAT([Date], "MMM yy"),
				"Future Date Flag", IF([Date] >= TODAY(), 1, 0)
				)

	annotation PBI_Id = 9c86cc4dc0c144b78de2b2b36e531e8b

